{
  "$schema": "http://json.schemastore.org/template",
  "author": "bma-wtag",
  "classifications": ["Web", "ASP.NET Core", "Microservice", "Clean Architecture"],
  "identity": "bma-wtag.Templates.DotnetMicroservice",
  "name": ".NET Microservice Starter",
  "shortName": "wtag-microservice",
  "preferNameDirectory": true,
  "defaultName": "SampleService",
